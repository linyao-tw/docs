---
import type { MarkdownHeading } from "astro";
import { ClientRouter } from "astro:transitions";
import { DocsSearch } from "@/components/DocsSearch";
import Icon from "@/components/Icon.astro";
import PageActions from "@/components/PageActions.astro";
import Sidebar from "@/components/Sidebar.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { markdownUrl } from "@/lib/markdown";
import { hrefFor, neighbours, productFor, sectionFor } from "@/lib/products";
import "@/styles/docs.css";

interface Props {
	id: string;
	title: string;
	description?: string | undefined;
	headings: MarkdownHeading[];
}

const { id, title, description, headings } = Astro.props;

const product = productFor(id);
if (!product) throw new Error(`找不到 ${id} 所屬的產品`);
const section = sectionFor(id);
if (!section) throw new Error(`找不到 ${id} 所屬的區塊`);

const { previous, next } = neighbours(id);
const canonical = new URL(hrefFor(id), Astro.site).href;
const pageTitle = `${title} — ${product.name}`;

/** 只有一個區塊的產品，麵包屑上顯示產品名稱比顯示區塊名稱有意義。 */
const eyebrow = product.sections.length > 1 ? `${product.name} · ${section.label}` : product.name;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={pageTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		{/* 每一頁都有對應的 Markdown，llms.txt 指向的就是它。 */}
		<link rel="alternate" type="text/markdown" href={markdownUrl(id)} />

		{
			/*
			在第一次繪製前決定主題，避免深色使用者看到一閃而過的亮色。
			這段必須是同步內嵌腳本，放到外部檔案就來不及了。
		*/
		}
		<script is:inline>
			(() => {
				const stored = (() => {
					try {
						return localStorage.getItem("linyao-docs-theme");
					} catch {
						return null;
					}
				})();
				const theme = stored === "light" || stored === "dark" ? stored : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				document.documentElement.setAttribute("data-lyds-theme", theme);
				document.documentElement.style.colorScheme = theme;
			})();
		</script>

		{
			/*
			客戶端導覽。換頁時只換 <main>，側欄、頁首與已經載入的 React runtime
			都留在原地 —— 產品切換器與搜尋索引因此只需要付一次代價。
		*/
		}
		<ClientRouter />
	</head>

	<body>
		<a class="skip-link" href="#content">跳到主要內容</a>

		<header class="site-header">
			<div class="site-header__rail">
				<button class="icon-button menu-button" id="menu-button" type="button" aria-label="開啟導覽選單" aria-expanded="false" aria-controls="sidebar">
					<Icon name="list" weight="bold" />
				</button>

				<a class="site-brand" href="/">
					<span class="site-brand__mark">麟曜</span>
					<span class="site-brand__label">文件</span>
				</a>

				{
					product.sections.length > 1 && (
						<nav class="site-sections" aria-label="文件區塊">
							{product.sections.map(item => (
								<a class="site-sections__link" href={hrefFor(item.entry)} aria-current={item.label === section.label ? "true" : undefined}>
									{item.label}
								</a>
							))}
						</nav>
					)
				}

				<div class="site-header__spacer"></div>

				<div class="site-header__actions">
					<DocsSearch client:idle />
					<ThemeToggle />
					<a class="icon-button" href="https://github.com/linyao-tw" rel="noreferrer noopener" target="_blank" aria-label="在 GitHub 上檢視原始碼">
						<Icon name="github-logo" weight="bold" />
					</a>
				</div>
			</div>
		</header>

		<div class="shell">
			<Sidebar product={product} section={section} currentId={id} />

			<div class="page">
				<main class="content" id="content">
					<article data-pagefind-body>
						<p class="content__eyebrow" data-pagefind-ignore>{eyebrow}</p>
						<h1>{title}</h1>

						<PageActions markdownUrl={markdownUrl(id)} canonical={canonical} />

						{
							/*
							description 取自內文第一段，只用於 meta 標籤、llms.txt 與搜尋結果。
							再渲染一次就會和內文重複，因此版面上不顯示；
							內文自己的第一段由 CSS 放大成前言。
						*/
						}
						<div class="prose">
							<slot />
						</div>
					</article>

					{
						(previous || next) && (
							<nav class="page-nav" aria-label="上下頁">
								{previous && (
									<a class="page-nav__link" href={hrefFor(previous.id)}>
										<span class="page-nav__label">上一頁</span>
										<span class="page-nav__title">{previous.label}</span>
									</a>
								)}
								{next && (
									<a class="page-nav__link page-nav__link--next" href={hrefFor(next.id)}>
										<span class="page-nav__label">下一頁</span>
										<span class="page-nav__title">{next.label}</span>
									</a>
								)}
							</nav>
						)
					}
				</main>

				<TableOfContents headings={headings} />
			</div>
		</div>

		{
			/*
			用 astro:page-load 而不是直接呼叫。

			模組腳本一輩子只會被求值一次，而客戶端導覽換掉的是整個 <main>：
			直接呼叫的話，第二頁開始的目錄、複製鈕、表格提示與圖表就再也不會
			被接上。這個事件在首次載入與每一次客戶端導覽都會發出。
		*/
		}
		<script>
			import { initDocs } from "@/scripts/docs";
			document.addEventListener("astro:page-load", initDocs);
		</script>
	</body>
</html>
