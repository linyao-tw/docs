{
	"name": "@linyao.tw/docs",
	"version": "0.1.0",
	"private": true,
	"description": "麟曜數位工作室的產品文件站，部署於 docs.linyao.tw",
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro build && pagefind --site dist",
		"dev": "astro dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preinstall": "npx only-allow pnpm",
		"prepare": "sh -c 'if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi'",
		"preview": "astro preview",
		"typecheck": "astro check"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.0",
		"@astrojs/react": "^6.0.5",
		"@linyao.tw/ui": "1.3.0",
		"@phosphor-icons/core": "^2.1.1",
		"@phosphor-icons/react": "^2.1.10",
		"astro": "^7.3.1",
		"mermaid": "^11.17.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-directive": "^4.0.0",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.5",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
	"engines": {
		"node": ">=24.20.0"
	}
}
